{%- comment -%} B.E.A.S.T. — footer {%- endcomment -%}
{%- assign nav_links = section.blocks | where: 'type', 'link' -%}
{%- assign socials = section.blocks | where: 'type', 'social' -%}
<footer class="beast-footer">
  <div class="beast-footer-content">
    <div class="beast-footer-brand">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 280 | image_tag: loading: 'lazy', widths: '140, 280, 420', alt: shop.name }}
      {%- else -%}
        <img src="{{ 'beast-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1080" height="1080" loading="lazy">
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}<div class="beast-footer-tagline">{{ section.settings.tagline | escape }}</div>{%- endif -%}
      {%- if section.settings.email != blank -%}<div class="beast-footer-email">✉ {{ section.settings.email | escape }}</div>{%- endif -%}
    </div>
    {%- if nav_links.size > 0 -%}
      <div class="beast-footer-links">
        {%- for block in nav_links -%}
          <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if socials.size > 0 -%}
      <div class="beast-footer-social">
        {%- for block in socials -%}
          <a href="{{ block.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  <div class="beast-footer-bottom">{{ section.settings.copyright | escape }}</div>
</footer>

{% schema %}
{
  "name": "B.E.A.S.T. Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (defaults to B.E.A.S.T. logo)" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Borowik's Elite Athletic & Strength Training" },
    { "type": "text", "id": "email", "label": "Email", "default": "borowikseliteathletics@gmail.com" },
    { "type": "text", "id": "copyright", "label": "Copyright line", "default": "© 2026 B.E.A.S.T. All rights reserved." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Footer link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "About" },
        { "type": "text", "id": "link", "label": "Link", "default": "#about" }
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Instagram" },
        { "type": "url", "id": "link", "label": "URL" }
      ]
    }
  ]
}
{% endschema %}
