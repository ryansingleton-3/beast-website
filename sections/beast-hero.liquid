{%- comment -%} B.E.A.S.T. — hero {%- endcomment -%}
<section class="beast-hero">
  <div class="beast-hero-grid"></div>
  <div class="beast-hero-left">
    {%- if section.settings.eyebrow != blank -%}
      <p class="beast-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="beast-hero-title">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_accent != blank %} <span class="beast-accent beast-type">{{ section.settings.heading_accent | escape }}</span>{% endif -%}
    </h1>
    {%- if section.settings.subheading != blank -%}
      <p class="beast-hero-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    <div class="beast-btns">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 | default: '#booking' }}" class="beast-btn-primary">{{ section.settings.button_label_1 | escape }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#programs' }}" class="beast-btn-outline">{{ section.settings.button_label_2 | escape }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="beast-hero-logo">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 840 | image_tag: loading: 'eager', widths: '420, 640, 840', alt: shop.name }}
    {%- else -%}
      <img src="{{ 'beast-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1080" height="1080" loading="eager">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "B.E.A.S.T. Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Borowik's Elite Athletic & Strength Training" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Train Like A" },
    { "type": "text", "id": "heading_accent", "label": "Accent word (animated)", "default": "Beast." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Elite strength, speed, and sports performance coaching for youth athletes ages 6+ and adults. Baseball, softball, personal 1-on-1 training, football, and speed & agility." },
    { "type": "text", "id": "button_label_1", "label": "Primary button label", "default": "Book a Session" },
    { "type": "text", "id": "button_link_1", "label": "Primary button link", "default": "#pricing" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "View Programs" },
    { "type": "text", "id": "button_link_2", "label": "Secondary button link", "default": "#programs" },
    { "type": "image_picker", "id": "image", "label": "Hero image (defaults to logo)" }
  ],
  "presets": [{ "name": "B.E.A.S.T. Hero" }]
}
{% endschema %}
