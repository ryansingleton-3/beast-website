{%- comment -%} B.E.A.S.T. — photo gallery {%- endcomment -%}
<section class="beast-section beast-section--card beast-fade" id="gallery">
  <div class="beast-wrap">
    {%- if section.settings.label != blank -%}<p class="beast-section-label">{{ section.settings.label | escape }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="beast-section-title">{{ section.settings.title | escape }}</h2>{%- endif -%}
    <div class="beast-gallery-grid beast-stagger">
      {%- for block in section.blocks -%}
        <div class="beast-gallery-item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', alt: block.settings.alt }}
          {%- else -%}
            <span class="beast-gallery-ph">Add Photo</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B.E.A.S.T. Gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Training in Action" },
    { "type": "text", "id": "title", "label": "Title", "default": "In The Gym. On The Field." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Training photo" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "B.E.A.S.T. Gallery",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
